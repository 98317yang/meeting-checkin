# Copy this file to .env (git-ignored) and fill in the values.
#   cp .env.example .env
# Avoid quote characters (' or ") inside passwords.

# --- Docker (read automatically by `docker compose`) -------------------------
# SQL Server requires 8+ characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=<strong-sa-password>
# Password for the least-privilege login the app uses (meeting_app).
APP_DB_PASSWORD=<strong-app-password>

# --- App settings -----------------------------------------------------------
# ASP.NET Core does NOT read .env files. Either `export` these lines in your shell
# before `dotnet run`, or store them once with user-secrets, e.g.
#   dotnet user-secrets set "ConnectionStrings:LineDb" "Server=localhost,1433;..."
# (user-secrets uses ":" where environment variables use "__").

ConnectionStrings__LineDb="Server=localhost,1433;Database=LineDB;User Id=meeting_app;Password=<strong-app-password>;Encrypt=True;TrustServerCertificate=True;Connect Timeout=10;"
ConnectionStrings__LineMeetingDb="Server=localhost,1433;Database=LineMeeting;User Id=meeting_app;Password=<strong-app-password>;Encrypt=True;TrustServerCertificate=True;Connect Timeout=10;"

# Public HTTPS URL (e.g. your ngrok dev domain), used for QR codes.
PublicBaseUrl="https://<your-subdomain>.ngrok-free.dev"

# From your own LINE Developers Console (LINE Login channel > LIFF).
LineLiff__LiffId="<your-liff-id>"
LineLiff__ChannelId="<your-channel-id>"

# Optional: restrict the desktop/admin pages to an internal network.
# Leave disabled for local development and demos.
Intranet__Enabled=false
# Intranet__AllowedIpPrefixes__0="10.0."
# Intranet__ComputerNamePattern="^PC[0-9]{3}$"
